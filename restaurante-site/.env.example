# Copie este arquivo para .env e preencha com seus valores reais.
# Nenhuma chave real deve ser commitada no repositório.

# Google Analytics 4
GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console (meta tag de verificação)
GOOGLE_SITE_VERIFICATION=

# WhatsApp (código do país + DDD + número, sem símbolos)
WHATSAPP_NUMBER=554799999999

# Google Maps (se for usar API em vez de iframe embutido)
GOOGLE_MAPS_API_KEY=

# Futuro backend / integrações de pagamento
MERCADO_PAGO_ACCESS_TOKEN=
STRIPE_SECRET_KEY=
